# Copy to .env.local for local testing; add the same keys in Vercel > Settings > Environment Variables.
# NEVER commit real values. .env.local is in .gitignore.

# From `npm run hash-password`
PASSWORD_HASH=
SESSION_SECRET=

# The ID from your sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=

# Paste the ENTIRE service-account JSON key file as one line, wrapped in single quotes locally.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: time zone for created_at / updated_at stamps
TZ_NAME=Australia/Sydney

# Optional: live weather on the home screen. Free key from https://openweathermap.org (sign up > API keys)
OPENWEATHER_API_KEY=
